# Canonical production URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://crystalaccounting.co.th

# Sub-path prefix when hosted under a project path (GitHub Pages sets this to
# /crystal-accountant in CI). Leave empty for local dev and the custom domain.
NEXT_PUBLIC_BASE_PATH=

# HTTPS endpoint from the selected static form provider (for example, Formspree).
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional Google Analytics 4 measurement ID. Analytics only loads after consent.
NEXT_PUBLIC_GA_ID=
